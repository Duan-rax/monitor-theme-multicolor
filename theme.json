{
  "name": "Multicolor 彩色主题",
  "short": "multicolor",
  "description": "极简状态面板，首页指标彩色显示",
  "version": "1.2.1",
  "author": "Duan-rax",
  "url": "https://github.com/Duan-rax/monitor-theme-multicolor",
  "config": [
    {
      "type": "title",
      "label": "背景与玻璃效果"
    },
    {
      "key": "backgroundEnabled",
      "type": "boolean",
      "label": "启用自定义背景",
      "default": false,
      "help": "启用后按当前亮色或暗色模式显示对应背景图片。"
    },
    {
      "key": "lightBackgroundUrl",
      "type": "string",
      "label": "亮色模式背景图片",
      "default": "",
      "help": "公开的 http(s) 图片地址或以 / 开头的站内路径；留空时使用纯色背景。"
    },
    {
      "key": "darkBackgroundUrl",
      "type": "string",
      "label": "暗色模式背景图片",
      "default": "",
      "help": "公开的 http(s) 图片地址或以 / 开头的站内路径；留空时回退到亮色背景图片。"
    },
    {
      "key": "backgroundBlur",
      "type": "number",
      "label": "背景虚化度",
      "default": 10,
      "min": 0,
      "max": 50,
      "help": "背景图片的高斯模糊半径，单位 px；0 表示不虚化。"
    },
    {
      "key": "backgroundPosition",
      "type": "select",
      "label": "背景图片对齐",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "top",
          "label": "顶部"
        },
        {
          "value": "bottom",
          "label": "底部"
        },
        {
          "value": "left",
          "label": "左侧"
        },
        {
          "value": "right",
          "label": "右侧"
        }
      ],
      "help": "决定图片裁切时优先保留的区域。人物靠一侧的壁纸可选左侧或右侧。"
    },
    {
      "key": "backgroundOverlay",
      "type": "number",
      "label": "背景暗色遮罩",
      "default": 20,
      "min": 0,
      "max": 80,
      "help": "覆盖在背景图片上的黑色遮罩强度（0-80%），用于提高文字可读性。"
    },
    {
      "key": "glassEnabled",
      "type": "boolean",
      "label": "启用玻璃样式",
      "default": false,
      "help": "让顶部栏、节点卡片和总览卡片使用半透明毛玻璃效果。"
    },
    {
      "key": "glassOpacity",
      "type": "number",
      "label": "玻璃不透明度",
      "default": 62,
      "min": 25,
      "max": 100,
      "help": "卡片底色的不透明度（25-100%）；建议 55-70%，数值越低，背景越明显。"
    },
    {
      "key": "glassBlur",
      "type": "number",
      "label": "玻璃模糊半径",
      "default": 24,
      "min": 0,
      "max": 50,
      "help": "卡片后方内容的模糊半径，单位 px。"
    },
    {
      "key": "glassSaturation",
      "type": "number",
      "label": "玻璃色彩饱和度",
      "default": 135,
      "min": 50,
      "max": 200,
      "help": "玻璃后方背景的色彩饱和度，100 为原始色彩。"
    }
  ]
}
